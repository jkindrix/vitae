exports[`HTML snapshots > professional theme matches snapshot 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Alex Rivera - Resume</title>
  <style>
/* Professional Theme for Vitae
 * Classic, formal resume design with serif typography
 * Ideal for traditional industries: law, finance, academia
 */

/* ============================================
   CSS Custom Properties (Design Tokens)
   ============================================ */
:root {
  /* Colors - Conservative palette */
  --color-text: #222222;
  --color-text-secondary: #444444;
  --color-text-muted: #666666;
  --color-accent: #1a365d;
  --color-border: #333333;
  --color-border-light: #cccccc;
  --color-background: #ffffff;

  /* Typography - Serif for professional feel */
  --font-serif: Georgia, "Times New Roman", Times, serif;
  --font-sans: "Helvetica Neue", Arial, sans-serif;
  --font-size-base: 10.5pt;
  --font-size-sm: 10pt;
  --font-size-lg: 11.5pt;
  --font-size-xl: 13pt;
  --font-size-2xl: 14pt;
  --font-size-3xl: 20pt;
  --line-height-tight: 1.2;
  --line-height-normal: 1.3;
  --line-height-relaxed: 1.4;

  /* Spacing */
  --space-xs: 0.2rem;
  --space-sm: 0.4rem;
  --space-md: 0.75rem;
  --space-lg: 1.25rem;
  --space-xl: 2rem;
}

/* ============================================
   Base Styles
   ============================================ */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  font-size: var(--font-size-base);
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}

body {
  font-family: var(--font-serif);
  font-size: var(--font-size-base);
  line-height: var(--line-height-normal);
  color: var(--color-text);
  background: var(--color-background);
}

a {
  color: var(--color-accent);
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

/* ============================================
   Resume Container
   ============================================ */
.resume {
  max-width: 8.5in;
  margin: 0 auto;
  padding: var(--space-lg);
}

/* ============================================
   Header Section
   ============================================ */
.resume__header {
  text-align: center;
  margin-bottom: var(--space-lg);
  padding-bottom: var(--space-md);
  border-bottom: 2px solid var(--color-border);
}

.resume__name {
  font-family: var(--font-serif);
  font-size: var(--font-size-3xl);
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text);
  margin-bottom: var(--space-xs);
}

.resume__title {
  font-family: var(--font-sans);
  font-size: var(--font-size-lg);
  font-weight: 400;
  font-style: italic;
  color: var(--color-text-secondary);
  margin-bottom: var(--space-sm);
}

.resume__contact {
  font-family: var(--font-sans);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-sm);
}

.resume__contact-item {
  white-space: nowrap;
}

.resume__contact-item:not(:last-child)::after {
  content: "|";
  margin-left: var(--space-sm);
  color: var(--color-border-light);
}

.resume__contact-item a {
  color: var(--color-text-secondary);
}

/* ============================================
   Sections
   ============================================ */
.resume__section {
  margin-bottom: var(--space-lg);
}

.resume__section:last-child {
  margin-bottom: 0;
}

.resume__section-title {
  font-family: var(--font-sans);
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  border-bottom: 1px solid var(--color-border);
  padding-bottom: var(--space-xs);
  margin-bottom: var(--space-md);
}

/* ============================================
   Summary
   ============================================ */
.resume__summary {
  font-size: var(--font-size-base);
  line-height: var(--line-height-relaxed);
  color: var(--color-text);
  text-align: justify;
  hyphens: auto;
}

/* ============================================
   Entry (Experience, Education, Projects)
   ============================================ */
.resume__entry {
  margin-bottom: var(--space-md);
}

.resume__entry:last-child {
  margin-bottom: 0;
}

.resume__entry-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-bottom: var(--space-xs);
}

.resume__entry-primary {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.resume__entry-secondary {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  text-align: right;
}

.resume__entry-title {
  font-family: var(--font-serif);
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-text);
}

a.resume__entry-title {
  color: var(--color-accent);
}

.resume__entry-org {
  font-family: var(--font-serif);
  font-size: var(--font-size-base);
  font-style: italic;
  color: var(--color-text-secondary);
}

.resume__entry-desc {
  font-family: var(--font-serif);
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  font-style: italic;
  margin-left: var(--space-sm);
}

.resume__entry-dates {
  font-family: var(--font-sans);
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.resume__entry-location {
  font-family: var(--font-sans);
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.resume__entry-summary {
  font-size: var(--font-size-base);
  line-height: var(--line-height-normal);
  color: var(--color-text);
  margin: var(--space-xs) 0;
  text-align: justify;
}

/* ============================================
   Highlights (Bullet Points)
   ============================================ */
.resume__highlights {
  list-style: disc;
  padding-left: var(--space-lg);
  margin: var(--space-xs) 0 0 0;
}

.resume__highlights li {
  font-size: var(--font-size-base);
  line-height: var(--line-height-normal);
  color: var(--color-text);
  margin-bottom: var(--space-xs);
  text-align: justify;
}

.resume__highlights li:last-child {
  margin-bottom: 0;
}

/* ============================================
   Skills
   ============================================ */
.resume__skills {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.resume__skill-category {
  font-size: var(--font-size-base);
  line-height: var(--line-height-normal);
}

.resume__skill-label {
  font-family: var(--font-sans);
  font-weight: 700;
  color: var(--color-text);
}

.resume__skill-items {
  font-family: var(--font-serif);
  color: var(--color-text);
}

/* ============================================
   Certifications
   ============================================ */
.resume__certifications {
  list-style: none;
  padding: 0;
  margin: 0;
}

.resume__certifications li {
  font-size: var(--font-size-base);
  margin-bottom: var(--space-xs);
  color: var(--color-text);
}

.resume__certifications li:last-child {
  margin-bottom: 0;
}

.resume__cert-name {
  font-weight: 700;
}

/* ============================================
   Languages
   ============================================ */
.resume__languages {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm) var(--space-lg);
}

.resume__language {
  font-family: var(--font-serif);
  font-size: var(--font-size-base);
  color: var(--color-text);
}

/* ============================================
   Entry Summary (shared for awards, publications, etc.)
   ============================================ */
.resume__entry-summary {
  font-family: var(--font-serif);
  font-size: var(--font-size-base);
  color: var(--color-text);
  margin-top: var(--space-xs);
  text-align: justify;
}

/* ============================================
   References
   ============================================ */
.resume__reference {
  margin-bottom: var(--space-md);
}

.resume__reference:last-child {
  margin-bottom: 0;
}

.resume__reference-name {
  font-family: var(--font-serif);
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-text);
}

.resume__reference-quote {
  font-family: var(--font-serif);
  font-size: var(--font-size-base);
  font-style: italic;
  color: var(--color-text);
  margin: var(--space-xs) 0 0 var(--space-md);
  padding-left: var(--space-sm);
  border-left: 2px solid var(--color-border-light);
}

/* ============================================
   Print Styles
   ============================================ */
@media print {
  html {
    font-size: 10.5pt;
  }

  body {
    background: white;
  }

  .resume {
    max-width: none;
    padding: 0;
    margin: 0;
  }

  a {
    color: var(--color-text);
    text-decoration: none;
  }

  .resume__contact-item a {
    color: var(--color-text-secondary);
  }

  /* Prevent page breaks inside elements */
  .resume__entry {
    page-break-inside: avoid;
  }

  .resume__section-title {
    page-break-after: avoid;
  }
}

/* ============================================
   Screen-only Styles (Preview)
   ============================================ */
@media screen {
  body {
    padding: var(--space-xl) var(--space-md);
    background: #f0f0f0;
  }

  .resume,
  .cover-letter {
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }
}

/* ============================================
   Cover Letter Styles
   ============================================ */
.cover-letter {
  max-width: 8.5in;
  margin: 0 auto;
  padding: var(--space-lg);
  font-family: var(--font-serif);
  font-size: var(--font-size-base);
  line-height: var(--line-height-relaxed);
  color: var(--color-text);
}

.cover-letter__header {
  text-align: center;
  margin-bottom: var(--space-lg);
  padding-bottom: var(--space-md);
  border-bottom: 2px solid var(--color-border);
}

.cover-letter__name {
  font-family: var(--font-sans);
  font-size: var(--font-size-3xl);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-accent);
  margin-bottom: var(--space-xs);
}

.cover-letter__title {
  font-family: var(--font-sans);
  font-size: var(--font-size-lg);
  font-weight: 400;
  color: var(--color-text-secondary);
  margin-bottom: var(--space-sm);
}

.cover-letter__contact {
  font-family: var(--font-sans);
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  margin-bottom: var(--space-xs);
}

.cover-letter__contact-item {
  display: inline;
}

.cover-letter__contact-item:not(:last-child)::after {
  content: " | ";
  color: var(--color-border-light);
}

.cover-letter__links {
  font-family: var(--font-sans);
  font-size: var(--font-size-sm);
}

.cover-letter__link {
  color: var(--color-accent);
  text-decoration: none;
}

.cover-letter__link:hover {
  text-decoration: underline;
}

.cover-letter__link:not(:last-child)::after {
  content: " | ";
  color: var(--color-border-light);
}

.cover-letter__date {
  margin-bottom: var(--space-md);
  color: var(--color-text-muted);
}

.cover-letter__recipient {
  margin-bottom: var(--space-md);
  line-height: var(--line-height-normal);
}

.cover-letter__recipient p {
  margin: 0;
  color: var(--color-text);
}

.cover-letter__subject {
  margin-bottom: var(--space-md);
  color: var(--color-accent);
}

.cover-letter__greeting {
  margin-bottom: var(--space-md);
}

.cover-letter__body p {
  margin-bottom: var(--space-md);
  text-indent: 0;
}

.cover-letter__body p:last-child {
  margin-bottom: var(--space-md);
}

.cover-letter__closing {
  margin-top: var(--space-lg);
}

.cover-letter__closing p {
  margin: 0;
}

.cover-letter__signature {
  margin-top: var(--space-lg);
  font-family: var(--font-sans);
  font-weight: 600;
}

@media print {
  .cover-letter {
    max-width: none;
    padding: 0;
    margin: 0;
  }

  .cover-letter__link {
    color: var(--color-text);
    text-decoration: none;
  }
}

</style>
  
  
</head>
